    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close">&times;</button>
      <button class="lightbox-nav prev" type="button" data-lightbox-dir="-1" aria-label="Previous photo">←</button>
      <img id="lightbox-img" src="" alt="" />
      <button class="lightbox-nav next" type="button" data-lightbox-dir="1" aria-label="Next photo">→</button>
